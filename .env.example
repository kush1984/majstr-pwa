# Backend REST API base URL. Dev default points at the local Spring Boot app.
# Leave it as the absolute URL for normal desktop dev.
#
# For PHONE testing through an HTTPS tunnel, set it EMPTY (VITE_API_BASE_URL=)
# so the app uses relative /api URLs and the Vite dev proxy forwards them to the
# backend — one origin, no mixed-content, no extra CORS entry. See README
# "Testing web push". Optionally point the proxy elsewhere with VITE_PROXY_TARGET.
VITE_API_BASE_URL=http://localhost:8080

# Support contacts shown in Профіль → Допомога. Unset/empty → these defaults
# (support@majstr.pro / +380978938990), so you only set them to override.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=

# Sentry error reporting (client). Leave EMPTY to disable Sentry entirely —
# that's the dev default, so nothing is sent and the SDK never gets in the way.
# Set a real DSN in production to capture unhandled + render errors.
VITE_SENTRY_DSN=
# Optional environment tag (dev/prod) sent with every event. Defaults to the
# Vite build mode when unset.
VITE_SENTRY_ENVIRONMENT=

# PostHog product analytics + session replay (client). Leave EMPTY to disable it
# entirely — that's the dev default: the SDK isn't even downloaded and nothing is
# sent. Set a real key in production. EU region (Frankfurt), not US.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Session-replay sample rate, 0..1. Unset/invalid → 1 (record every session), which
# is the deliberate default: replay is the reason PostHog is here and the free tier's
# 5k recordings/month are far out of reach. Lower it only near the quota.
VITE_POSTHOG_REPLAY_SAMPLE_RATE=
