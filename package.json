  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.ts",
    "test:e2e:offline:shell": "playwright test --config=playwright.offline.config.ts e2e-offline/shell.spec.ts",
    "typecheck:tests": "tsc -b tsconfig.test.json"
  },
  "dependencies": {
