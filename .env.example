# Backend REST API base URL. Dev default points at the local Spring Boot app.
# Leave it as the absolute URL for normal desktop dev.
#
# For PHONE testing through an HTTPS tunnel, set it EMPTY (VITE_API_BASE_URL=)
# so the app uses relative /api URLs and the Vite dev proxy forwards them to the
# backend — one origin, no mixed-content, no extra CORS entry. See README
# "Testing web push". Optionally point the proxy elsewhere with VITE_PROXY_TARGET.
VITE_API_BASE_URL=http://localhost:8080

# Web push: the VAPID public key is NOT configured here. The PWA fetches it at
# runtime from GET /api/push/vapid-public-key, so the keypair lives only on the
# backend (env VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT).
