    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "7z-wasm": "^1.2.0",
    "axios": "^1.7.9",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
